{
  "compilerOptions": {
    "target": "ES2020",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": false,
    "outDir": "build",
    "declaration": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "build",
    "src/index.ts",
    "src/index-helpers.ts",
    "src/document-operations.ts",
    "src/schema-operations.ts",
    "src/blueprint-operations.ts",
    "src/doctype-operations.ts",
    "src/workflow-operations.ts",
    "src/frappe-helpers.ts"
  ]
}