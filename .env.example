# Multi-Tenant MCP Server Configuration

# Port for the MCP server
MCP_PORT=4000

# Path to the sites configuration file (mcp-sites.json)
# This file contains credentials for all sites
SITES_CONFIG_PATH=/home/SenaERP/bench/mcp-sites.json

# Format of mcp-sites.json:
# {
#   "sites": {
#     "site1.example.com": {
#       "url": "https://site1.example.com",
#       "api_key": "your_api_key",
#       "api_secret": "your_api_secret"
#     },
#     "site2.example.com": {
#       "url": "https://site2.example.com",
#       "api_key": "your_api_key",
#       "api_secret": "your_api_secret"
#     }
#   }
# }
